<Window x:Class="AutoSchool.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола — вход" Height="420" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F5F9">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Автошкола" FontSize="28" FontWeight="Bold"
                       Foreground="#1B2A49" HorizontalAlignment="Center"/>
            <TextBlock Text="Войдите в систему" Foreground="#6B7280"
                       HorizontalAlignment="Center" Margin="0,4,0,24"/>

            <TextBlock Text="Логин" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginBox" Height="32" FontSize="14" Padding="6,4"/>

            <TextBlock Text="Пароль" Margin="0,14,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="32" FontSize="14" Padding="6,4"/>

            <TextBlock x:Name="ErrorText" Foreground="#C0392B"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Button Content="Войти" Height="38" Margin="0,18,0,0"
                    Background="#1B2A49" Foreground="White" FontSize="14"
                    Click="LoginButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
